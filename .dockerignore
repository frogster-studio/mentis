# Build context for apps/api/Dockerfile; the supabase glob stays path-independent so a schema
# change never lands in the image and busts its cache.
.git
**/node_modules
**/dist
**/.env*
apps/admin
apps/mobile
# Re-included because bun install --frozen-lockfile validates every workspace manifest.
!apps/admin/package.json
!apps/mobile/package.json
**/supabase
docs
.agents
.claude
.feeds
.grilled
.private
*.md
