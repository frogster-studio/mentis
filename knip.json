{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {},
    "apps/admin": {},
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "*.{js,ts}"],
      "ignoreDependencies": ["expo-updates", "react-native-purchases"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/_database/datasource.cli.ts", "src/_database/migrations/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/answer-matching": {
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    }
  }
}
