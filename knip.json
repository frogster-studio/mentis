{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {},
    "apps/admin": {},
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}", "*.{js,ts}"],
      "ignoreDependencies": ["expo-updates"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "scripts/seed.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    }
  }
}
