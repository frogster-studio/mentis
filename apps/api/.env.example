# Copy to .env for local dev (bun auto-loads it). Railway injects these in prod.
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
# sb_secret_* service key (Dashboard → Project Settings → API keys). Server-only.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Comma-separated browser origins; stays empty until Expo web ships.
CORS_ORIGINS=
