SUPABASE_URL=https://<project_id>.supabase.co
# sb_secret_* service key (Dashboard -> API keys) - first of the two secrets.
SUPABASE_SECRET_KEY=sb_secret_...
# Session-pooler Postgres URL (Dashboard -> Connect) - carries the DB password, the second secret.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database_name>
# Browser-origin allowlist - set when Expo web ships (alongside the store release).
CORS_ORIGINS=
