SUPABASE_URL=https://<project_id>.supabase.co
# sb_secret_* service key (Dashboard -> API keys).
SUPABASE_SECRET_KEY=sb_secret_...
# Session-pooler Postgres URL (Dashboard -> Connect) - carries the DB password.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database_name>
# Browser-origin allowlist - set when Expo web ships (alongside the store release).
CORS_ORIGINS=
# The static Authorization header RevenueCat is configured to send on every webhook delivery.
REVENUECAT_WEBHOOK_AUTH=
# sk_* REST key (RevenueCat -> API keys) - resync fetches current entitlements with it.
REVENUECAT_REST_KEY=sk_...
