{
  "name": "@mentis/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun run --filter @mentis/contracts --filter @mentis/answer-matching build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typeorm": "bunx --bun typeorm -d src/_database/datasource.cli.ts",
    "migration:generate": "bun run typeorm migration:generate src/_database/migrations/migration",
    "migration:run": "bun run typeorm migration:run",
    "migration:revert": "bun run typeorm migration:revert",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mentis/answer-matching": "workspace:*",
    "@mentis/contracts": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@supabase/supabase-js": "^2.110.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
