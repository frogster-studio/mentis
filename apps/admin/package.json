  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@jsquash/webp": "^1.5.0",
    "@mentis/contracts": "workspace:*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-query": "^5.101.2",
    "next": "16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
