{
  "name": "@mentis/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run prepare:image-codec && bun run --filter @mentis/contracts build && next dev",
    "build": "bun run prepare:image-codec && bun run --filter @mentis/contracts build && next build",
    "start": "next start",
