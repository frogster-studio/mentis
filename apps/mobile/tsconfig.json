{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      // Web drops the `react-native` export condition, which would leave these resolving built dist.
      "@mentis/answer-matching": ["../../packages/answer-matching/src/index.ts"],
      "@mentis/contracts/*": ["../../packages/contracts/src/*/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
