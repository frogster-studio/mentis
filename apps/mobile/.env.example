# Client-side only — every value here is inlined into the app bundle by Expo and is publishable by
# design. The app holds no secret: quiz and account data go through the API gateway, which is the
# only thing holding a key to the database. `cp .env.example .env` is a complete setup.

EXPO_PUBLIC_SUPABASE_URL=https://cwfpkehhgjhllitcazwe.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IhO50Rn_o-jT_S5DJjVIQA_E9haQYjw

# Origin of the apps/api gateway. Point it at a local `bun run dev` (http://<your-LAN-ip>:3001 — a
# device cannot reach the Mac's localhost) when working against a local API.
EXPO_PUBLIC_API_URL=https://mentis-production-5adc.up.railway.app

# Web client id → GoogleSignin.configure({ webClientId }); makes the native ID token's audience Supabase-trusted.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=725997667068-ebvtgkks3neln9nvs78gptfj3b0edlvs.apps.googleusercontent.com
# iOS client id → its reversed form is the iOS URL scheme the config plugin registers (see app.json).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=725997667068-7gj1ttegttrpoh4ri6klugqnj676sf8l.apps.googleusercontent.com

# Optional: your Apple signing team, stamped into the regenerated Xcode project by the
# with-ios-development-team plugin. Unset is fine — Simulator builds do not enforce signing.
# APPLE_TEAM_ID=
