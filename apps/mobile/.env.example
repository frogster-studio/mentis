SUPABASE_URL=https://cwfpkehhgjhllitcazwe.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_IhO50Rn_o-jT_S5DJjVIQA_E9haQYjw
# Supabase secret key (Project Settings → API keys). Full-access, server-side only —
# used by the seed pipeline; set the real value in the git-ignored .env, never here.
SUPABASE_SECRET_KEY=

# Client-side (inlined into the app bundle by Expo; publishable by design)
EXPO_PUBLIC_SUPABASE_URL=https://cwfpkehhgjhllitcazwe.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IhO50Rn_o-jT_S5DJjVIQA_E9haQYjw

# Web client id → GoogleSignin.configure({ webClientId }); makes the native ID token's audience Supabase-trusted.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=725997667068-ebvtgkks3neln9nvs78gptfj3b0edlvs.apps.googleusercontent.com
# iOS client id → its reversed form is the iOS URL scheme the config plugin registers (slice 004).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=725997667068-7gj1ttegttrpoh4ri6klugqnj676sf8l.apps.googleusercontent.com
# Android client id → matched implicitly by package + SHA-1; kept for reference only (not bundled).
GOOGLE_ANDROID_CLIENT_ID=725997667068-ikne7tbgivic5uhqrd7il3g595ihanve.apps.googleusercontent.com
