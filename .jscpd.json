{
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "crossFormats": "js-ts",
  "minTokens": 50,
  "minLines": 5,
  "reporters": ["console"],
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.next-preview*/**",
    "**/.expo/**",
    "**/ios/**",
    "**/android/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/web-build/**",
    "**/coverage/**",
    "**/*.min.*",
    "**/next-env.d.ts",
    "**/expo-env.d.ts"
  ]
}
